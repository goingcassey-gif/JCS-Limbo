# Copy to .env and fill in. Never paste these values in chat or commit .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=
# Private channel only the core team can see. Flags are posted here.
REVIEW_CHANNEL_ID=
# Role that may press the review buttons (the core team role).
CORE_ROLE_ID=
# Where the flag database is saved.
DB_PATH=./data/flags.db
# How many new flags one member can send per hour.
MAX_FLAGS_PER_HOUR=5
