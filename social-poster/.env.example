# Copy this file to .env and fill it in on the server. Never paste these values into chat.

PORT=3000
# The https address people (and Instagram/Threads) use to reach this app, e.g. https://post.example.com
PUBLIC_BASE_URL=
DATA_DIR=./data
DISPLAY_TZ=Asia/Manila

# Practice mode: true = approving sends nothing. Set to false only when the accounts below pass `npm run check`.
DRY_RUN=true

# Sign-in codes. Give TEAM_CODE to the team; APPROVER_CODE is Cassey's only.
# SESSION_SECRET: any random text of 32+ characters (e.g. run: openssl rand -hex 32)
SESSION_SECRET=
TEAM_CODE=
APPROVER_CODE=

# Facebook Page (Page ID + a Page access token with pages_manage_posts, pages_read_engagement)
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Instagram professional account linked to that Page. IG_TOKEN defaults to FB_PAGE_TOKEN.
# Needs instagram_basic + instagram_content_publish.
IG_USER_ID=
IG_TOKEN=

# Threads (Threads user ID + long-lived token with threads_basic, threads_content_publish). Renewed daily by the app.
THREADS_USER_ID=
THREADS_TOKEN=

# X (from the X developer portal app with Read and Write permission: API Key/Secret + Access Token/Secret)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Meta Graph API version
GRAPH_VERSION=v23.0
